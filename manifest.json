{
  "manifest_version": 3,
  "name": "MAX Архив",
  "version": "0.3.17",
  "description": "Локальный экспорт чатов MAX с сообщениями и вложениями",
  "permissions": [
    "tabs",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://*.max.ru/*",
    "https://i.oneme.ru/*",
    "https://fd.oneme.ru/*",
    "https://*.okcdn.ru/*",
    "https://raw.githubusercontent.com/just-trust-digital/max-chat-archive/*",
    "https://api.github.com/repos/just-trust-digital/max-chat-archive/*",
    "https://pult.justtrust.digital/bugs/report/*"
  ],
  "action": {
    "default_title": "Экспорт MAX",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "background": {
    "service_worker": "timer-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.max.ru/*"
      ],
      "js": [
        "download-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://web.max.ru/*"
      ],
      "js": [
        "format.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
