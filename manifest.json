{
  "manifest_version": 3,
  "name": "MAX Архив",
  "version": "0.2.2",
  "description": "Локальный экспорт чатов MAX в ZIP",
  "permissions": ["tabs", "storage", "downloads"],
  "host_permissions": ["https://*.max.ru/*", "https://i.oneme.ru/*", "https://fd.oneme.ru/*", "https://*.okcdn.ru/*"],
  "action": { "default_title": "Экспорт MAX", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://web.max.ru/*"],
      "js": ["download-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.max.ru/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
